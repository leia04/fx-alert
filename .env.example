# Copy this file to .env and fill in the values. (.env is git-ignored.)

# ── Email (default channel) ─────────────────────────────
# Gmail: use a 16-character App Password, NOT your normal password.
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
# Comma-separated; defaults to SMTP_USER (send to yourself)
EMAIL_TO=
# Only change these if you are not using Gmail (e.g. smtp.office365.com / 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ── AI briefing (optional — alerts still work without it) ─
ANTHROPIC_API_KEY=

# ── Other channels (optional) ───────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# ── Official Korean rate (optional — falls back to free public APIs) ─
EXIM_API_KEY=
